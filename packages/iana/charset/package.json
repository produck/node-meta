{
  "author": "ChaosLee",
  "bugs": {
    "url": "https://github.com/produck/node-meta/issues"
  },
  "description": "IANA Character Sets registry as static metadata for Node.js.",
  "devDependencies": {
    "fast-xml-parser": "^5.2.0"
  },
  "exports": {
    ".": {
      "import": "./src/index.mjs",
      "types": "./src/index.d.mts"
    },
    "./data": {
      "import": "./src/data/index.mjs",
      "types": "./src/data/index.d.mts"
    },
    "./mib/*": {
      "import": "./src/data/record/*.mjs",
      "types": "./src/data/record.d.mts"
    }
  },
  "files": [
    "src"
  ],
  "homepage": "https://github.com/produck/node-meta/tree/main/packages/iana/charset#readme",
  "keywords": [
    "charset",
    "iana",
    "metadata",
    "mime",
    "node"
  ],
  "license": "MIT",
  "name": "@produck/meta-iana-charset",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "directory": "packages/iana/charset",
    "type": "git",
    "url": "git+https://github.com/produck/node-meta.git"
  },
  "scripts": {
    "produck:coverage": "c8 --reporter=lcov --reporter=html --reporter=text-summary npm test",
    "sync": "node scripts/sync.mjs",
    "test": "node test/index.mjs",
    "type-check": "tsc --noEmit"
  },
  "sideEffects": false,
  "type": "module",
  "version": "0.1.2"
}
